        <mxCell id="bar" parent="1" style="rounded=1;whiteSpace=wrap;dashed=1;fontSize=11;fillColor=#fffbe6;strokeColor=#d6b656;fontStyle=1;" value="Dependencias de consumo entre módulos: las flechas punteadas van del consumidor al proveedor. Los controladores componen las lecturas de ficha y supervisión." vertex="1">
          <mxGeometry height="40" width="1120" x="40" y="730" as="geometry" />
        </mxCell>
        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" value="Base de datos única PostgreSQL&#10;(ocho entidades: Usuario, Cliente, Equipo, Tecnico, Servicio, Diagnostico, Trabajo y Repuesto)" vertex="1">
          <mxGeometry height="120" width="460" x="370" y="870" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" value="&lt;br&gt;• &lt;b&gt;Flechas de color, continuas:&lt;/b&gt; el actor usa ese módulo. El administrador registra clientes, equipos, servicios y técnicos, asigna los servicios, crea las cuentas y supervisa. El técnico inicia sesión, consulta sus servicios asignados y cambia su estado, y registra diagnósticos, mantenimientos, reparaciones y repuestos. El cliente consulta su servicio con el código de seguimiento, sin cuenta.&lt;br&gt;• &lt;b&gt;Flechas grises, punteadas:&lt;/b&gt; el módulo de origen usa la interfaz del módulo de destino. Servicios usa Clientes y equipos (el servicio es de un equipo de un cliente) y Técnicos (para asignarlo). Cuentas y acceso usa Técnicos (la cuenta es de un técnico registrado). Mantenimientos y reparaciones usa Servicios (cada registro pertenece a un servicio). Consulta y seguimiento usa Servicios y Mantenimientos y reparaciones. El computador se obtiene por Servicios; supervisión agrega el filtro de técnicos desde el controlador. La ficha del cliente compone su historial desde el controlador. Todas van en un solo sentido, sin ciclos.&lt;br&gt;• &lt;b&gt;Flechas negras, de doble punta:&lt;/b&gt; el navegador y el servidor se comunican por HTTPS (solicitud y respuesta), y el servidor lee y escribe en la base de datos." vertex="1">
          <mxGeometry height="190" width="1160" x="20" y="1010" as="geometry" />
        </mxCell>
