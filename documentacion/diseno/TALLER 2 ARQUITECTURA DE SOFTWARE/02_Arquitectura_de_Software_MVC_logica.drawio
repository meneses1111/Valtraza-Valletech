<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="valtraza-mvc-capas" name="Arquitectura de software MVC">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Arquitectura de software de Valtraza: Modelo-Vista-Controlador (MVC) por capas con Laravel y PostgreSQL" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="1120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act0" value="Administrador" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="60" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="Técnico" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="385" y="60" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="Cliente (sin cuenta)" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nav" value="Navegador web (Google Chrome / Mozilla Firefox): el usuario ve y usa la página web" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="820" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cap1" value="CAPA DE PRESENTACIÓN" style="swimlane;whiteSpace=wrap;startSize=26;fontSize=12;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="820" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cap2" value="CAPA DE CONTROL" style="swimlane;whiteSpace=wrap;startSize=26;fontSize=12;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="820" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cap3" value="CAPA DE LÓGICA DE NEGOCIO" style="swimlane;whiteSpace=wrap;startSize=26;fontSize=12;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="820" height="160" as="geometry" />
        </mxCell>
        <mxCell id="cap4" value="CAPA DE ACCESO A DATOS" style="swimlane;whiteSpace=wrap;startSize=26;fontSize=12;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="820" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cap5" value="CAPA DE DATOS" style="swimlane;whiteSpace=wrap;startSize=26;fontSize=12;fillColor=#f8f8f8;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1030" width="820" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bV" value="VISTA" style="rounded=1;whiteSpace=wrap;horizontal=0;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="18" y="230" width="34" height="160" as="geometry" />
        </mxCell>
        <mxCell id="bC" value="CONTROLADOR" style="rounded=1;whiteSpace=wrap;horizontal=0;fontSize=14;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="18" y="430" width="34" height="180" as="geometry" />
        </mxCell>
        <mxCell id="bM" value="MODELO" style="rounded=1;whiteSpace=wrap;horizontal=0;fontSize=14;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="18" y="650" width="34" height="340" as="geometry" />
        </mxCell>
        <mxCell id="vista" value="&lt;b style=&quot;font-size:14px&quot;&gt;VISTA&lt;/b&gt;&lt;br&gt;&lt;i&gt;Lo que ve y usa el usuario&lt;/i&gt;&lt;br&gt;• Plantillas Blade con HTML, CSS, JavaScript y Bootstrap&lt;br&gt;• Pantallas del administrador y del técnico (con sesión): formularios de registro, listados y tablas de servicios&lt;br&gt;• Pantalla pública de consulta por código de seguimiento (el cliente no inicia sesión)&lt;br&gt;• Muestra los datos que entrega el controlador, con avisos y mensajes de error" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="266" width="780" height="116" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="&lt;b style=&quot;font-size:14px&quot;&gt;CONTROLADOR&lt;/b&gt;&lt;br&gt;&lt;i&gt;Coordina vista y modelo&lt;/i&gt;&lt;br&gt;• Rutas y varios controladores por módulo: cuentas y acceso, clientes y equipos, técnicos, servicios, mantenimientos y reparaciones, y consulta&lt;br&gt;• Middleware de sesión y rol (excepto en el inicio de sesión, la activación de la cuenta y la consulta pública por código)&lt;br&gt;• Valida los datos recibidos&lt;br&gt;• Decide qué operación ejecutar y qué vista mostrar; al guardar, redirige al detalle actualizado; las otras vistas se actualizan al consultarse de nuevo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="466" width="780" height="136" as="geometry" />
        </mxCell>
        <mxCell id="logica" value="&lt;b style=&quot;font-size:14px&quot;&gt;MODELO: lógica de negocio&lt;/b&gt;&lt;br&gt;&lt;i&gt;Reglas del sistema&lt;/i&gt;&lt;br&gt;• Reglas de negocio (por ejemplo, no completar un servicio sin diagnóstico; el historial se conserva al reasignar el técnico)&lt;br&gt;• Genera los códigos únicos de equipo, servicio y seguimiento; guarda las contraseñas con hash y sal&lt;br&gt;• Los observers emiten eventos después de confirmar la transacción; no se promete actualización en tiempo real" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="686" width="780" height="114" as="geometry" />
        </mxCell>
        <mxCell id="acceso" value="&lt;b style=&quot;font-size:14px&quot;&gt;MODELO: acceso a datos&lt;/b&gt;&lt;br&gt;&lt;i&gt;Entidades y almacenamiento&lt;/i&gt;&lt;br&gt;• Modelos Eloquent: Usuario (administrador y técnico), Cliente, Equipo, Técnico, Servicio, Diagnóstico, Trabajo (mantenimiento o reparación), y Repuesto&lt;br&gt;• Lee y guarda los datos en la base de datos mediante consultas y migraciones" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;spacingRight=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="80" y="886" width="780" height="96" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Base de datos única&#10;PostgreSQL" style="shape=cylinder3;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="1064" width="220" height="86" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="&lt;b style=&quot;font-size:14px&quot;&gt;HERRAMIENTAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Backend:&lt;/b&gt; PHP 8.3 con Laravel 12&lt;br&gt;&lt;br&gt;&lt;b&gt;Vistas:&lt;/b&gt; Blade, HTML, CSS, JavaScript y Bootstrap&lt;br&gt;&lt;br&gt;&lt;b&gt;Acceso a datos:&lt;/b&gt; Eloquent (ORM) y migraciones de Laravel&lt;br&gt;&lt;br&gt;&lt;b&gt;Base de datos:&lt;/b&gt; PostgreSQL 18&lt;br&gt;&lt;br&gt;&lt;b&gt;Servidor web:&lt;/b&gt; Nginx con HTTPS&lt;br&gt;&lt;br&gt;&lt;b&gt;Seguridad:&lt;/b&gt; sesiones y roles de Laravel; contraseñas con hash y sal&lt;br&gt;&lt;br&gt;&lt;b&gt;Pruebas:&lt;/b&gt; PHPUnit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="930" y="230" width="270" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ea0" value="Entrada" style="endArrow=classic;html=1;fontStyle=1;" edge="1" parent="1" source="act0" target="nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea1" value="Entrada" style="endArrow=classic;html=1;fontStyle=1;" edge="1" parent="1" source="act1" target="nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" value="Entrada" style="endArrow=classic;html=1;fontStyle=1;" edge="1" parent="1" source="act2" target="nav">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="Pantalla web (HTTPS)" style="endArrow=classic;html=1;fontStyle=1;startArrow=classic;" edge="1" parent="1" source="nav" target="cap1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="Solicitud del usuario" style="endArrow=classic;html=1;fontStyle=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vista" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="Actualización de la vista" style="endArrow=classic;html=1;fontStyle=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="vista">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Petición al modelo" style="endArrow=classic;html=1;fontStyle=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ctrl" target="logica">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="Resultado de la operación" style="endArrow=classic;html=1;fontStyle=1;dashed=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="logica" target="ctrl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Operaciones sobre los datos" style="endArrow=classic;html=1;fontStyle=1;startArrow=classic;" edge="1" parent="1" source="logica" target="acceso">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="Lectura / escritura" style="endArrow=classic;html=1;fontStyle=1;startArrow=classic;" edge="1" parent="1" source="acceso" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
