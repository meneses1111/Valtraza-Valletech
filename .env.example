APP_NAME=Valtraza
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://valtraza.test

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=valtraza
DB_USERNAME=postgres
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT=5000
DB_LOCK_TIMEOUT=3000

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

LOG_CHANNEL=daily
LOG_LEVEL=warning
